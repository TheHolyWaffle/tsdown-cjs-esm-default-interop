{
  "name": "tsdown-cjs-esm-default-interop",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "repro": "node -e \"require('./dist/index.cjs')\""
  },
  "dependencies": {
    "chalk": "^5"
  },
  "devDependencies": {
    "tsdown": "0.22.3"
  }
}
